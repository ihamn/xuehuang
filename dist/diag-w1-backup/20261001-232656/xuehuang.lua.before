--     │ ═══════ 打包台 ═══════            │             │
--     └──────────────────────────────────┴─────────────┘

local H = __m_host()
local STATE = __m_state()
local CFG = __m_config()

local V = {}

-- 工位定义（id 要和 recipes.lua / kitchen.lua 里的字符串一致）
--   ★ accent 是"这个工位的招牌色"，只用在小地方（左色条 / 标题 / 进度条）
V.STATIONS = {
  { id = 'shake', name = '\230\141\163\233\148\164\229\140\186', key = 'B', accent = { 78, 150, 255 } },   -- 蓝
  { id = 'fire',  name = '\231\129\171\231\179\187\229\140\186', key = 'H', accent = { 255, 138, 58 } },   -- 橙
  { id = 'chem',  name = '\229\140\150\229\173\166\229\140\186', key = 'C', accent = { 176, 124, 255 } },  -- 紫
