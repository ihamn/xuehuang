V.STATION_NAME = { shake = '\230\141\163\233\148\164\229\140\186', fire = '\231\129\171\231\179\187\229\140\186', chem = '\229\140\150\229\173\166\229\140\186', brew = '\232\144\131\232\140\182\229\140\186', pack = '\230\137\147\229\140\133\229\143\176' }

-- ── 配色：底全是近黑深色，颜色留给小面积元素 ──
local C = {
  panelBg  = { 26, 30, 44, 240 },
  cardBg   = { 36, 42, 60, 245 },
  cardHot  = { 46, 54, 78, 250 },
  cardDone = { 34, 52, 54, 245 },
  stripBg  = { 18, 21, 32, 245 },
  text     = { 238, 243, 252, 255 },
  dim      = { 176, 190, 218, 255 },
  faint    = { 128, 142, 170, 255 },
  gold     = { 255, 214, 130, 255 },
  good     = { 122, 232, 160, 255 },
  bad      = { 255, 122, 132, 255 },
  warn     = { 255, 196, 96, 255 },
  stepOk   = { 255, 255, 255, 255 },
  stepTodo = { 62, 70, 92, 255 },
}

local MAX_ORDERS = 5

-- 订单行布局参数（建池与同步共用，避免重复魔数）
local CARD_H, CARD_W, CARD_PW = 104, 330, 14
local BAR_W = CARD_W - CARD_PW - 24

local txtCache, colCache = {}, {}
local function setText(c, s)
  if not c then return end
  s = tostring(s)
  if txtCache[c] == s then return end
  txtCache[c] = s
  pcall(function() c.text = s end)
end
local function setFont(c, size, col)
  if not c then return end
  local key = tostring(size) .. '|' .. (col and (col[1] * 65536 + col[2] * 256 + col[3]) or 'd')
  if colCache[c] == key then return end
  colCache[c] = key
  pcall(function()
    if size then c.fontSize = size end
    if col then c.fontColor = Color.FromRGB(col[1], col[2], col[3]) end
  end)
end

local function recName(o)
  if o.makeup and o.makeup ~= '' then return o.makeup end
  local r = o.lines and o.lines[1] and o.lines[1].rec
  return r and r.name or '?'
end

-- ── 把控件提到同级最上层（Z 序）──
--   ★ 这层的铁律是"**后建的控件盖在先建的上面**"，而 HUD 很早就建了 →
--     后面的工位/订单面板全都会盖住 HUD（表现："HUD 文字看不见"，但控件其实存在且在屏幕内）。
--   所以 HUD 全部建完后要显式提到最上层。
function H.raiseTop(c)
  if not c then return false end
  local ok = pcall(function() c:SetAsLastSibling() end)
  if not ok then pcall(function() c:SetSiblingIndex(999) end) end
  return ok
end

-- ── 玩区显隐 ──
--   ★ 只在"场景切换"时调一次（进菜单/开局），**不要每帧对比状态**。
--   我第一版写成"每帧检查+自愈"，结果和别处的显隐逻辑互相打架，
--   表现为"方块一会儿有一会儿没有"，查了很久。教训：显隐要有**单一触发点**。
function V.setBoardVisible(v, on)
  if not v or not v.stations then return 0 end
  local n = 0
  local function toggle(ctl)
    if not ctl then return end
    -- ★ 不用 H.show/Hide，直接调 API，并把**调用是否抛错**记下来
    --   （曾经出现"调用成功但状态不变"的情况，所以要连"调用结果+回读"一起看）
    pcall(function() ctl:SetActive(on and true or false) end)
    pcall(function() ctl:SetVisible(on and true or false) end)
    n = n + 1
  end
  for _, st in ipairs(V.STATIONS) do
    local slot = v.stations[st.id]
    if slot then
      toggle(slot.box); toggle(slot.edge); toggle(slot.title); toggle(slot.body)
    end
  end
  toggle(v.pack.box); toggle(v.pack.edge); toggle(v.pack.label)
  return n
end

-- ── 初始化：建池 ──
function V.init(hostCfg)
  local v = { cfg = hostCfg, stations = {}, orders = {} }
  local W, H0 = hostCfg.spaceW or hostCfg.canvasW, hostCfg.spaceH or hostCfg.canvasH
  v.scale = H0 / 720
  v.baseW = math.min(W / v.scale, 1280)   -- 横向基准上限 = 16:9（设计画布 1600x900）
  v.W, v.H = W, H0
  v.xGrow = v.baseW / 1280
  -- ★ 偏移默认 **0**：我一度按"截图看起来偏右"填了 -380，结果量出来方块全跑到屏幕外
  --   （用户截图里蓝块中心 = 屏幕 565 像素，和我算的 565 完全吻合 → 本来就没偏）。
  --   需要微调时再改 tuneX（设计单位，会乘 scale）。
  v.tuneX = (tonumber(tostring(H.param('tuneX', 0))) or 0) * v.scale
  v.tuneY = (tonumber(tostring(H.param('tuneY', 0))) or 0) * v.scale

  -- 工位 2x2（底板 + 左色条 + 标题 + 状态 + 步骤点）
  for i, st in ipairs(V.STATIONS) do
    local col, row = (i - 1) % 2, math.floor((i - 1) / 2)
    local x = (col == 0) and -300 or 10
    local y = (row == 0) and 70 or -60
    local w, h = 290, 112
    -- ★ 工位**整块上色**（用户明确要"彩色色块"）：
    --   我上一版做成"深底 + 左彩条"，看着偏暗、被用户当成"彩色没恢复"。
    local box, edge = H.spawnBox(hostCfg, 'St_' .. st.id, x, y, w, h, st.accent, nil, nil, 0)
    local title = H.spawn(hostCfg, 'text', 'StT_' .. st.id)
    local body  = H.spawn(hostCfg, 'text', 'StB_' .. st.id)
    H.setPos(title, x + CARD_PW / 2 + 8, y + 30); H.setSize(title, w - CARD_PW - 24, 26)
    setFont(title, 21, C.text)          -- 彩底上用白字
    -- ★ 进度条**已删除**（用户："进度条也不想要"）。
    --   进度信息只靠方块里的文字表达（"连按 3/5"、"按住"、"第 N 步"）。
    H.setPos(body, x + CARD_PW / 2 + 8, y - 14); H.setSize(body, w - CARD_PW - 24, 56)
    setFont(body, 15, { 240, 246, 255 })   -- 彩底上的正文也提亮
    setText(title, st.name .. '  ' .. st.key)
    setText(body, '\231\173\137\229\190\133\229\176\143\231\165\168')
    -- ★ 步骤点（每工位 6 个 14x8 小方块）**已删除**：
    --   用户反馈"有几个很小的装饰性方块没删干净"——就是这 24 个。
    --   它们是我加的"这一步做完没有"的指示，但和方块里的文字重复，而且看着像残留。
    v.stations[st.id] = { box = box, edge = edge, title = title, body = body,
                          x = x, y = y, w = w, h = h, accent = st.accent }
  end

  -- 打包台（扁长卡片 + 顶部色条）
  do
    local x, y, w, h = -330, -212, 660, 76
    -- ★ 打包台和 4 个工位一样**整块上色**（用户：整体彩色也挺好看，别改成深底）。
    --   上一版做成了"深底 + 顶部细条"→ 深底占大半，看着发闷。
    local box, edge = H.spawnBox(hostCfg, 'St_pack', x, y, w, h, V.PACK.accent, nil, nil, 0)
    local label = H.spawn(hostCfg, 'text', 'StLab_pack')
    H.setPos(label, x, y); H.setSize(label, w - 30, 54)
    setFont(label, 22, C.text)   -- 亮底上用白字（原来用青绿字，在青绿底上会糊）
    setText(label, V.PACK.name .. '  ' .. V.PACK.key)
    v.pack = { box = box, edge = edge, label = label, x = x, y = y, w = w, h = h }
  end

  -- HUD
  -- 订单面板
  do
    local pw, ph = CARD_W + 24, 700
    local px = ((v.baseW / 2) - (10 / v.scale) - (pw / 2)) * v.scale
    local py = -8
    local panel = H.spawn(hostCfg, 'img', 'OrderPanel')
    H.setPos(panel, px, py); H.setSize(panel, pw, ph)
    H.setColor(panel, C.panelBg[1], C.panelBg[2], C.panelBg[3], C.panelBg[4])
    local head = H.spawn(hostCfg, 'text', 'OrderHead')
    H.setPos(head, px, py + ph / 2 - 30); H.setSize(head, pw - 30, 26)
    setFont(head, 18, C.gold)
    setText(head, '\231\173\137\229\128\153\229\140\186')
    v.panel = { box = panel, head = head, x = px, y = py, w = pw, h = ph }
  end

  -- 订单行
  for i = 1, MAX_ORDERS do
    local y = 236 - (i - 1) * (CARD_H + 8)
    local box, edge = H.spawnBox(hostCfg, 'Od_' .. i, v.panel.x, y, CARD_W, CARD_H, C.cardBg, 'left', C.stepTodo, CARD_PW)
    local who  = H.spawn(hostCfg, 'text', 'OdW_' .. i)
    local what = H.spawn(hostCfg, 'text', 'OdT_' .. i)
    local pbar = H.spawn(hostCfg, 'img', 'OdB_' .. i)
    local pfil = H.spawn(hostCfg, 'img', 'OdF_' .. i)
    local tx = v.panel.x + CARD_PW / 2 + 6
    H.setPos(who, tx, y + 32);  H.setSize(who, CARD_W - CARD_PW - 26, 28)
    setFont(who, 19, C.text)
    H.setPos(what, tx, y + 4);  H.setSize(what, CARD_W - CARD_PW - 26, 24)
    setFont(what, 14, C.faint)
    H.setPos(pbar, tx, y - 34); H.setSize(pbar, BAR_W, 10)
    H.setColor(pbar, C.stripBg[1], C.stripBg[2], C.stripBg[3], 255)
    H.setPos(pfil, tx - BAR_W / 2, y - 34); H.setSize(pfil, BAR_W, 10)
    H.setColor(pfil, C.good[1], C.good[2], C.good[3], 255)
    H.hideBox(box, edge, who, what, pbar, pfil)   -- ★ 建完立刻藏（新控件默认纯白+可见）
    v.orders[i] = { box = box, edge = edge, who = who, what = what, pbar = pbar, pfil = pfil,
                    x = v.panel.x, y = y }
  end

  -- 横向铺满 + 手动微调（无条件跑）
  do
    local function grow(c, depth)
      if not c or depth > 3 then return end
      local x, y = nil, nil
      local ok = pcall(function() x, y = c.anchoredPositionX, c.anchoredPositionY end)
      if ok and type(x) == 'number' and type(y) == 'number' then
        local isPanel = (c.name == 'OrderPanel' or c.name == 'OrderHead')
        local nx = isPanel and x or (x * v.xGrow)
        pcall(function() c:SetAnchoredPosition(nx + v.tuneX, y + v.tuneY) end)
      end
      local ok2, kids = pcall(function() return c:GetChildren() end)
      if ok2 and type(kids) == 'table' then for i = 1, #kids do grow(kids[i], depth + 1) end end
    end
    grow(hostCfg.root, 0)
    -- ★ 订单卡不用再偏移一次：上面那趟 grow 已经把 root 下所有控件都走过了
    --   （包括订单卡）。我原来又补了一段"专门给订单卡加偏移" → **偏移被应用两次**
    --   → 整块 UI 被推到屏幕外（本地出图直接看到方块跑出左边界）。
  end


  H.say('view', '\231\137\136\229\188\143v2\239\188\154\229\159\186\229\135\134 %sx720\239\188\136\229\174\185\229\153\168 %sx%s\239\188\140\231\188\169\230\148\190 %.3f\239\188\140\229\190\174\232\176\131 %s,%s\239\188\137',
        tostring(math.floor(v.baseW)), tostring(W), tostring(H0), v.scale,
        tostring(v.tuneX), tostring(v.tuneY))

  -- ★★ 坐标标尺（脚本变量 ruler=1 打开）：在 5 个已知 x 位置放标记块 + 编号。
  --   用途：让用户在真机上报告"最左/最右能看到哪个编号"，就能反推容器的真实范围与原点。
  --   我在这上面盲猜过两次（以为"看着偏右"），所以改成直接量。
  if tonumber(tostring(H.param('ruler', 0))) ~= 0 then
    local marks = { -640, -320, 0, 320, 640 }
    for i, mx in ipairs(marks) do
      local blk = H.spawn(hostCfg, 'img', 'Ruler' .. i)
      H.setPos(blk, mx, 200); H.setSize(blk, 60, 60)
      H.setColor(blk, 255, 60, 60, 255)
      local lb = H.spawn(hostCfg, 'text', 'RulerT' .. i)
      H.setPos(lb, mx, 200); H.setSize(lb, 120, 30)
      setFont(lb, 20, { 255, 255, 255 })
      setText(lb, tostring(mx))
      H.raiseTop(blk); H.raiseTop(lb)
    end
    H.say('view', '\229\157\144\230\160\135\230\160\135\229\176\186\229\183\178\229\187\186\239\188\154x = -640 / -320 / 0 / 320 / 640\239\188\136y=200\239\188\137')
  end

  -- ★★ HUD 放在**最后建**：这层的规则是"后建的盖在先建的上面"，
  --   最后建就天然在最上层，不依赖 SetAsLastSibling（模拟器里实测它不改渲染顺序）。
  v.hud = {}
  -- ★★ HUD 底衬：文字直接压在游戏画面上（天空很亮）→ 白字看不见。
  --   加一块**整条深色板**在最上层……不，Z 序是"后建的在上"，所以**先建底衬、再建文字**。
  do
    local bar = H.spawn(hostCfg, 'img', 'HudBar')
    H.setPos(bar, 0, 196); H.setSize(bar, 1280, 74)
    H.setColor(bar, 14, 17, 26, 205)
    v.hud.bar = bar
  end
  v.hud.title = H.spawn(hostCfg, 'text', 'HudTitle')
  H.setPos(v.hud.title, -320, 214); H.setSize(v.hud.title, 620, 34)
  setFont(v.hud.title, 24, { 255, 224, 150 })
  setText(v.hud.title, '\233\155\170\231\154\135\231\154\132\229\144\142\229\142\168     [v2]')
  v.hud.clock = H.spawn(hostCfg, 'text', 'HudClock')
  H.setPos(v.hud.clock, 320, 214); H.setSize(v.hud.clock, 620, 34)
  setFont(v.hud.clock, 24, { 238, 246, 255 })
  v.hud.stats = H.spawn(hostCfg, 'text', 'HudStats')
  H.setPos(v.hud.stats, 0, 182); H.setSize(v.hud.stats, 1240, 28)
  setFont(v.hud.stats, 18, { 210, 224, 248 })

  -- ★★ 把 HUD/面板提到最上层 —— **必须放在 init 的最末尾**！
  --   我第一次放在中间，结果后面建的订单卡把它推翻了（Z 序实测：Od_5 排最后 = 最上）。
  do
    local raised = 0
    for _, ctl in ipairs({ v.hud.bar, v.hud.title, v.hud.clock, v.hud.stats,
                           v.panel.box, v.panel.head }) do
      if H.raiseTop(ctl) then raised = raised + 1 end
    end
    H.say('view', 'HUD/\233\157\162\230\157\191\229\183\178\230\143\144\229\136\176\230\156\128\228\184\138\229\177\130\239\188\154%d \228\184\170\239\188\136\230\148\190\229\156\168 init \230\156\171\229\176\190\239\188\137', raised)
  end

  return v
end

-- ── 把逻辑状态映射成控件属性（每帧；只读状态、改属性，不含玩法规则）──
function V.sync(v, s)
  if not v or not s then return end

  -- HUD
  local left = (s.phase == 'closing') and s.closingLeft or s.dayLeft
  setText(v.hud.clock, string.format('\231\172\172 %d/%d \229\164\169   %02d:%02d   \230\128\187\229\137\169 %02d:%02d',
      s.day, s.mode.days, math.floor(left / 60), math.floor(left % 60),
      math.floor(s.totalLeft / 60), math.floor(s.totalLeft % 60)))
  v._statsBase = string.format('\233\146\177 %d    \229\135\186\233\164\144 %d    \230\181\129\229\164\177 %d    \231\191\187\232\189\166 %d    \232\191\158\229\135\187 %d    \229\156\168\229\136\182 %d/%d    \231\173\137\229\128\153 %d',
      s.money, s.served, s.left, s.mistakes, s.combo,
      STATE.wipCount(s), CFG.kitchen.maxWip, s.orders and #s.orders or 0)
  setText(v.hud.stats, v._statsBase)

  -- 工位
  local waitN = 0
  for _, sl in ipairs(s.slips) do
    if sl.cup.startedAt == nil and sl.cup.slotReady ~= true and sl.ready ~= true then waitN = waitN + 1 end
  end
  for _, st in ipairs(V.STATIONS) do
    local slot = v.stations[st.id]
    local mine = nil
    for _, sl in ipairs(s.slips) do
      local nx = STATE.nextStep(sl.cup)
      if nx and nx.st == st.id then mine = sl; break end
    end
    if mine then
      local nx = STATE.nextStep(mine.cup)
      local rec = mine.cup.rec
      local tag = (rec and rec.tag) and ('[' .. rec.tag .. '] ') or ''
      local prog = ''
      if nx.kind == 'mash' then prog = string.format('   \232\191\158\230\140\137 %d/%d', nx.done or 0, nx.taps or 1)
      elseif nx.kind == 'hold' then prog = '   \230\140\137\228\189\143' end
      setText(slot.body, tag .. nx.t .. prog)
      -- 有活：在本色上提亮一档（一眼看出"现在该按这里"）
      local a = st.accent
      H.setColor(slot.box, math.min(255, a[1] + 42), math.min(255, a[2] + 42), math.min(255, a[3] + 42), 255)


    else
      if waitN > 0 then
        setText(slot.body, string.format('\231\173\137\229\190\133\229\176\143\231\165\168   \239\188\136\229\144\142\229\142\168\230\187\161\228\186\134\239\188\140%d \230\157\175\229\156\168\231\173\137\229\144\141\233\162\157\239\188\137', waitN))
      else
        setText(slot.body, '\231\173\137\229\190\133\229\176\143\231\165\168')
      end
      local a = st.accent
      H.setColor(slot.box, a[1], a[2], a[3], 255)

    end
  end

  -- 打包台
  do
    local n, names = 0, {}
    for _, sl in ipairs(s.slips) do
      if sl.ready then
        n = n + 1
        if #names < 3 then names[#names + 1] = (sl.cup.rec and sl.cup.rec.name) or '?' end
      end
    end
    local a = V.PACK.accent
    if n > 0 then
      -- 有东西等着交付：提亮一档（亮 = 提示"按空格"）
      H.setColor(v.pack.box, math.min(255, a[1] + 40), math.min(255, a[2] + 40), math.min(255, a[3] + 40), 255)
      setText(v.pack.label, string.format('%s  %s      \229\143\175\228\186\164\228\187\152 %d \230\157\175\239\188\154%s%s     \239\188\136\230\140\137\231\169\186\230\160\188\239\188\137',
        V.PACK.name, V.PACK.key, n, table.concat(names, '\227\128\129'), n > 3 and ' \226\128\166' or ''))
    else
      H.setColor(v.pack.box, a[1], a[2], a[3], 255)
      setText(v.pack.label, string.format('%s  %s      \230\154\130\230\151\182\230\178\161\230\156\137\232\166\129\228\186\164\228\187\152\231\154\132', V.PACK.name, V.PACK.key))
    end
  end

  -- 订单行
  local oi = 0
  for _, o in ipairs(s.orders) do
    oi = oi + 1
    local card = v.orders[oi]
    if not card then break end
    H.show(card.box); H.show(card.edge); H.show(card.who); H.show(card.what)
    H.show(card.pbar); H.show(card.pfil)
    local frac = math.max(0, math.min(1, o.pat / (o.patMax > 0 and o.patMax or 1)))
    local acc = o.inProgress and { 96, 150, 240 } or C.stepTodo
    if frac < 0.28 then acc = C.bad end
    H.setColor(card.box, C.cardBg[1], C.cardBg[2], C.cardBg[3], C.cardBg[4])
    H.setColor(card.edge, acc[1], acc[2], acc[3], 255)
    local q = o.inProgress and '\229\156\168\229\136\182' or ('\231\173\137\229\128\153 #' .. tostring(o.queueNo))
    setText(card.who, string.format('%s    %s', o.name, q))
    setText(card.what, string.format('%s %s   \229\183\178\229\129\154 %d/%d   \232\128\144\229\191\131 %d%%',
        o.ice or '', o.sugar or '', o.made or 0, o.need, math.floor(frac * 100)))
    H.setSize(card.pfil, math.max(1, math.floor(BAR_W * frac)), 10)
    local pc = frac < 0.28 and C.bad or (frac < 0.6 and C.warn or C.good)
    H.setColor(card.pfil, pc[1], pc[2], pc[3], 255)
  end
  for i = oi + 1, MAX_ORDERS do
    local card = v.orders[i]
    H.hideBox(card.box, card.edge, card.who, card.what, card.pbar, card.pfil)
  end
  if oi == 0 then setText(v.panel.head, '\231\173\137\229\128\153\229\140\186   \230\154\130\230\151\182\230\178\161\228\186\186') else setText(v.panel.head, '\231\173\137\229\128\153\229\140\186 / \229\156\168\229\136\182') end
end

-- ═══════════════════════════════════════════════════════════════════
-- 界面态：菜单 / 结算页 / 总分  —— 直接借用 HUD 的三行文字，不另建控件
--   （平台新建控件默认"纯白+可见"，少建少坑；而且上限只有 1000 个）
-- ═══════════════════════════════════════════════════════════════════

-- 隐藏/显示"玩区"的所有方块（进菜单时把它们收起来）
--   注意：只隐藏，不销毁 —— 运行期不建不销毁是这层的铁律
-- 菜单：标题 + 三个模式（用 HUD 三行显示，选中的左边加 ▶ ）
function V.drawMenu(v, sel)
  if not v then return end
  local M = {
    { key = 'quick', label = '\233\128\159\233\128\154' },
    { key = 'fast',  label = '\230\160\135\229\135\134' },
    { key = 'slow',  label = '\230\133\162\231\130\150' },
  }
  setFont(v.hud.title, 30, C.gold)
  setText(v.hud.title, '\233\155\170\231\154\135\231\154\132\229\144\142\229\142\168')
  local lines = {}
  for i, m in ipairs(M) do
    local mk = (i == sel) and '\226\150\182 ' or '   '
    lines[#lines + 1] = string.format('%s%s. %s', mk, tostring(i), m.label)
  end
  setFont(v.hud.clock, 22, C.text)
  setText(v.hud.clock, table.concat(lines, '     '))
  setFont(v.hud.stats, 18, C.dim)
  -- 把三个模式的实际时长写清楚（来自 config.lua：days / perDay）
  -- ★ 字段名是 config 里的 `modes`（小写！）。我写成 MODES → nil → 在 boot() 里抛错
  --   → **整个启动失败**（菜单、彩框全没有）。这类"取错字段"的错最阴险：
  --   单测能过（drawMenu 没被调），只在真机/模拟器跑起来才炸。
  local CFGM = __m_config().modes
  local parts = {}
  for i = 1, 3 do
    local m = M[i] and CFGM[M[i].key]
    if m then parts[#parts + 1] = string.format('%d=%d\229\164\169x%d\229\136\134', i, m.days, math.floor((m.perDay or 0) / 60)) end
  end
  local tipLine = '\230\140\137 1/2/3 \233\128\137\239\188\140\231\169\186\230\160\188\229\188\128\229\167\139          ' .. table.concat(parts, '   ')
  v._statsBase = tipLine       -- 供入口追加"版本+场景"用（否则那行会只剩版本标记）
  setText(v.hud.stats, tipLine)
end

-- 结算页 / 总分：把当日日报或最终评分写进标题与时钟行
function V.drawResult(v, s)
  if not v or not s then return end
  if s.ended and s.result then
    local r = s.result
    setFont(v.hud.title, 30, C.gold)
    setText(v.hud.title, string.format('\230\148\182\230\145\138\239\188\129\232\175\132\231\186\167 %s', tostring(r.rank)))
    setFont(v.hud.clock, 24, C.text)
    setText(v.hud.clock, string.format('\230\128\187\229\136\134 %d  \239\188\136\229\135\186\233\164\144 %d \194\183 \230\181\129\229\164\177 %d \194\183 \231\191\187\232\189\166 %d\239\188\137',
      r.total or 0, s.served or 0, s.left or 0, s.mistakes or 0))
    setFont(v.hud.stats, 18, C.dim)
    setText(v.hud.stats, '\230\140\137\231\169\186\230\160\188\229\155\158\229\136\176\232\143\156\229\141\149\239\188\140\229\134\141\230\157\165\228\184\128\229\177\128')
    return
  end
  if s.settling then
    local last = s.dayStats and s.dayStats[#s.dayStats]
    setFont(v.hud.title, 28, C.gold)
    setText(v.hud.title, string.format('\231\172\172 %d \229\164\169\231\187\147\231\174\151\229\174\140\228\186\134', s.day))
    setFont(v.hud.clock, 22, C.text)
    if last then
      setText(v.hud.clock, string.format('\229\135\186\233\164\144 %d \230\157\175 \194\183 \232\144\165\228\184\154\233\162\157 %d \194\183 \230\181\129\229\164\177 %d \194\183 \231\191\187\232\189\166 %d',
        last.served or 0, last.revenue or 0, last.left or 0, last.mistakes or 0))
    else
      setText(v.hud.clock, '')
    end
    setFont(v.hud.stats, 18, C.dim)
    setText(v.hud.stats, string.format('\230\136\191\233\146\177\229\183\178\228\187\152 \194\183 \230\137\139\228\184\138\232\191\152\229\137\169 %d \229\133\131      \230\140\137\231\169\186\230\160\188\231\187\167\231\187\173', s.money or 0))
  end
end

return V

  end)()
  if __c_view == nil then __c_view = true end
  return __c_view
end
-- ── 入口源码（与本层同级：能看见上面的缓存；生命周期函数在这里定义 = 真正的全局）──
-- @entry
-- xuehuang.lua —— 雪皇的后厨 · 千星客户端脚本入口（正式版）
--
-- 这一层只做四件事：
--   ① 生命周期接线（OnInit / OnStart / OnUpdate）
--   ② 状态机：菜单 → 营业 → 当日结算 → 总分 → 重开
--   ③ 输入路由（按键 + 光标点击 → 逻辑层动作 / 界面操作）
--   ④ 把逻辑层的事件变成提示文案
-- ★ 它**不含任何玩法规则**：规则全在 kitchen/order/day 里，改规则不要改这个文件。
--
-- 平台契约（踩过的坑，别改回去）：
--   · 建控件必须在 OnStart 及之后（InstantiateClientUIControl 在 OnInit 返回 nil）
--   · 必须 script:EnableUpdate(true)，否则收不到 OnUpdate
--   · game 的全局函数用点号调用；新建控件默认"纯白 + 可见"→ 建完立刻设色或隐藏
--   · 光标点击要先 showCursor=true（host.lua 已设），且需要一个"光标检测区域"控件

local H = __m_host()
local G = __m_game()
local V = __m_view()
local IN = __m_input()
local CFG = __m_config()

local BUILD = 'xuehuang-d2'   -- 纯 ASCII，方便在日志里搜

local built, bootErr = false, nil
local v, hostCfg = nil, nil
local banner, bannerT, _bannerActive = nil, 0, false
local autoplay, heartbeat, showCounts, showBuild = false, false, false, true
local scene = 'menu'        -- 'menu' | 'play'
local menuMode = 1          -- 菜单上选中的模式（1..3）

local function say(...) H.say('\233\155\170\231\154\135', ...) end
local function tip(msg, sec)
  banner, bannerT = tostring(msg), (sec or 2.0)
  _bannerActive = true
  if v and v.hud and v.hud.title then H.setText(v.hud.title, banner) end
end

-- ── 逻辑事件 → 提示 ──
local function wireEvents()
  G.on('arrive', function(e) tip(string.format('%s \232\166\129 %s %s %s', e.o.name, e.o.makeup, e.o.ice, e.o.sugar), 2.2) end)
  G.on('leave',  function(e) tip(string.format('%s \231\173\137\228\184\141\229\143\138\232\181\176\228\186\134', e.o.name), 2.2) end)
  G.on('lastcall', function() tip('\230\156\128\229\144\142\230\142\165\229\141\149\239\188\154\228\185\139\229\144\142\228\184\141\229\134\141\230\148\190\228\186\186\232\191\155\230\157\165', 3) end)
  G.on('closing',  function() tip('\230\137\147\231\131\138\239\188\154\228\184\141\229\134\141\230\142\165\229\190\133\230\150\176\233\161\190\229\174\162\239\188\140\230\137\139\228\184\138\231\154\132\229\129\154\229\174\140\229\176\177\230\148\182\230\145\138', 3) end)
  G.on('graceout', function() tip('\230\184\133\229\156\186\230\151\182\233\151\180\229\136\176\239\188\154\229\138\168\232\191\135\230\137\139\231\154\132\231\174\151\228\186\164\228\187\152\239\188\140\230\178\161\229\188\128\229\183\165\231\154\132\232\174\176\230\181\129\229\164\177', 3) end)
  G.on('dayend',   function(e) tip(string.format('\231\172\172 %d \229\164\169\231\187\147\231\174\151', e.day), 3) end)
end

-- ── 状态机 ──
local function enterMenu()
  scene = 'menu'
  if v then
    local n = V.setBoardVisible(v, false)
    say('\232\191\155\232\143\156\229\141\149\239\188\154\233\154\144\232\151\143\231\142\169\229\140\186 %d \228\184\170\230\142\167\228\187\182', n)
  end
end

local function startGame(modeName)
  local m = modeName or IN.MODES[menuMode] or 'fast'
  G.newGame(m)
  scene = 'play'
  if v then
    local n = V.setBoardVisible(v, true)
    say('\229\188\128\229\177\128\239\188\154\230\152\190\231\164\186\231\142\169\229\140\186 %d \228\184\170\230\142\167\228\187\182', n)
  end
  tip(string.format('\229\188\128\229\188\160\239\188\129\230\140\137 1/H/K/P \229\129\154\229\183\165\228\189\141\239\188\140\231\169\186\230\160\188\230\137\147\229\140\133'), 3.5)
end

-- 菜单/结算页的按键消费；返回 true = 已消费
local function uiAct(act)
  if scene == 'menu' then
    if act == 'confirm' or act == 'pack' or act == 'shake' then startGame(); return true end
    return false
  end
  if G.s and (G.s.settling or G.s.ended) and (act == 'confirm' or act == 'pack') then
    if G.s.ended then enterMenu() else G.nextDay() end
    return true
  end
  return false
end

local function boot()
  if built then return end
  built = true
  local ok, err = pcall(function()
    local root = H.root()
    if not root then error('\230\137\190\228\184\141\229\136\176\230\140\130\232\189\189\230\142\167\228\187\182\239\188\154\232\132\154\230\156\172\232\166\129\230\140\130\229\156\168**\229\174\162\230\136\183\231\171\175\230\142\167\228\187\182\229\174\185\229\153\168**\228\184\138') end
    pcall(function() root:SetActive(true) end)
    hostCfg = H.setup(root)
    v = V.init(hostCfg)
    autoplay   = tonumber(tostring(H.param('autoplay', 0))) ~= 0
    heartbeat  = tonumber(tostring(H.param('heartbeat', 0))) ~= 0
    showCounts = tonumber(tostring(H.param('showCounts', 0))) ~= 0
    showBuild  = tonumber(tostring(H.param('showBuild', 1))) ~= 0
    if autoplay then say('autoplay=1\239\188\154\230\156\186\229\153\168\228\186\186\230\155\191\231\142\169\229\174\182\230\137\147\239\188\136\230\156\172\229\156\176\229\135\186\229\155\190\231\148\168\239\188\137') end
    wireEvents()
    IN.attach(hostCfg, tip)
    scene = 'menu'
    V.setBoardVisible(v, false)   -- 初始就是菜单态：先把玩区藏起来
    V.drawMenu(v, menuMode)
    say('\229\183\178\229\176\177\231\187\170 BUILD=%s \226\128\148\226\128\148 \230\140\137\231\169\186\230\160\188\229\188\128\229\167\139', BUILD)
    tip(string.format('BUILD=%s  \232\143\156\229\141\149\239\188\154\230\140\137 1/2/3 \233\128\137\230\168\161\229\188\143\239\188\140\231\169\186\230\160\188\229\188\128\229\167\139', BUILD), 6)
    say('\232\143\156\229\141\149\229\186\148\230\152\190\231\164\186\239\188\154\233\155\170\231\154\135\231\154\132\229\144\142\229\142\168 + \228\184\137\228\184\170\230\168\161\229\188\143\239\188\136\230\144\156\230\151\165\229\191\151\233\135\140\231\154\132 xuehuang-d2 \231\161\174\232\174\164\231\137\136\230\156\172\239\188\137')
  end)
  if not ok then
    bootErr = tostring(err)
    say('BUILD-FAILED %s', bootErr)
    pcall(function() if v and v.hud and v.hud.title then H.setText(v.hud.title, '!! ' .. bootErr) end end)
  end
end

function OnInit()
  say('OnInit\239\188\136\229\143\170\231\153\187\232\174\176\239\188\140\228\184\141\229\187\186\230\142\167\228\187\182\239\188\137')
  if script and script.EnableUpdate then
    local ok, e = pcall(function() script:EnableUpdate(true) end)
    say('EnableUpdate(true) -> %s', ok and 'ok' or tostring(e))
  end
end

function OnStart() boot() end

local _heart = 0
function OnUpdate(dt)
  _heart = _heart + 1
  if heartbeat and _heart % 60 == 0 then
    say('\229\191\131\232\183\179 %d \229\184\167 \194\183 \229\156\186\230\153\175=%s \194\183 t=%s', _heart, tostring(scene),
        G.s and string.format('%.1f', G.s.t) or 'nil')
  end
  if not built then boot() end
  if bootErr then return end
  local dt2 = dt or 0.033

  -- ① 逻辑推进（结算页/总分时冻结）
  if scene == 'play' and G.s and not G.s.settling and not G.s.ended then
    local ok, err = pcall(function() G.tick(dt2) end)
    if not ok then say('tick \229\135\186\233\148\153\239\188\154%s', tostring(err)); bootErr = tostring(err); return end
  end

  -- ② 自动演示（只在脚本变量 autoplay=1 时）
  if autoplay and scene == 'play' then
    pcall(function()
      if G.s and G.s.settling then G.nextDay()
      elseif G.s and not G.s.ended then __bot() end
    end)
  end

  -- ③ 输入：界面层优先，剩下的给玩法
  IN.pump({
    tip = tip,
    act = function(act, kind)
      if uiAct(act) then return nil end
      if scene ~= 'play' then return nil end
      if act == 'click' then
        if v then
          for _, st in ipairs(V.STATIONS) do
            local slot = v.stations[st.id]
            if IN.hit(v, slot.box, 8) then IN.clearClick(); return G.act(st.id, 'press') end
          end
          if IN.hit(v, v.pack.box, 8) then IN.clearClick(); return G.act('pack', 'press') end
        end
        IN.clearClick()
        return nil
      end
      if act == 'auto' then
        CFG.auto.on = not CFG.auto.on
        tip(CFG.auto.on and '\232\135\170\229\138\168\230\181\129\232\189\172\239\188\154\229\188\128\239\188\136\229\176\143\231\165\168\232\135\170\229\183\177\232\181\176\239\188\137' or '\232\135\170\229\138\168\230\181\129\232\189\172\239\188\154\229\133\179\239\188\136\232\166\129\228\189\160\228\186\178\230\137\139\233\128\129\239\188\137', 2)
        return nil
      end
      if act == 'ticket' then
        CFG.autoTicket.on = not CFG.autoTicket.on
        tip(CFG.autoTicket.on and '\232\135\170\229\138\168\229\135\186\231\165\168\239\188\154\229\188\128' or '\232\135\170\229\138\168\229\135\186\231\165\168\239\188\154\229\133\179', 2)
        return nil
      end
      return G.act(act, kind)
    end,
  })

  -- ④ 画面
  local okSync, errSync = pcall(V.sync, v, G.s)
  if not okSync then say('V.sync \229\135\186\233\148\153\239\188\154%s', tostring(errSync)) end
  -- ★ 玩区显隐：**每帧按 scene 对齐**（幂等，先设后不设）。
  --   为什么不用"切换时调一次"：实测那次调用会被后续逻辑推翻（14 个控件设成显示、
  --   下一帧又变回隐藏），查不出是谁干的。每帧对齐是"单一数据源"，不会再打架。
  if v then V.setBoardVisible(v, scene == 'play') end

  if scene == 'menu' then
    local okM, errM = pcall(V.drawMenu, v, menuMode)
    if not okM then
      say('V.drawMenu \229\135\186\233\148\153\239\188\154%s', tostring(errM))
      -- 出错也要让人看见：直接把错误写到标题上（比"什么都没有"强）
      if v and v.hud and v.hud.title then H.setText(v.hud.title, 'DRAW-ERR ' .. tostring(errM)) end
    end
  end
  -- ★ 常显"版本 + 场景"（不用日志就能确认跑的是哪一版）
  --   ⚠️ 必须**基于本帧的原始文本重建**，不能往控件现有文字后面追加！
  --   我第一版写成 H.setText(c, c.text .. '...') → 每帧追加一次 → 那行几秒后涨到几千字
  --   （本地量出来 "[xuehuang-d2 menu]" 重复了 5 次，还在涨）。这是"文字乱掉/看不见"的经典坑。
  if v and v.hud and v.hud.stats then
    local base = v._statsBase or ''
    local extra = ''
    if showBuild then extra = extra .. '    [' .. BUILD .. ' ' .. tostring(scene) .. ']' end
    if showCounts then extra = extra .. '   |   ' .. __counts() end
    if extra ~= '' then H.setText(v.hud.stats, base .. extra) end
  end
  if v and G.s and (G.s.settling or G.s.ended) then
    local okR, errR = pcall(V.drawResult, v, G.s)
    if not okR then say('V.drawResult \229\135\186\233\148\153\239\188\154%s', tostring(errR)) end
  end

  -- ⑤ 提示计时（放在最后：横幅显示期间它说了算；横幅结束后**只重置一次**，别每帧覆盖菜单/结算）
  if bannerT > 0 then
    bannerT = bannerT - dt2
    if bannerT <= 0 then
      _bannerActive = false
      if v and v.hud and v.hud.title and scene == 'play' then H.setText(v.hud.title, '\233\155\170\231\154\135\231\154\132\229\144\142\229\142\168') end
    end
  end
end

function OnLevelUpdate(dt) end
function OnDestroy() end

-- ── 外部调用入口（script:Invoke）＋ 自检 ──
function __state()
  local s = G.s
  if not s then return 'no-game' end
  return H.fmt('scene=%s t=%.1f day=%d/%d phase=%s orders=%d slips=%d served=%d money=%d ended=%s',
    tostring(scene), s.t, s.day, s.mode.days, s.phase, #s.orders, #s.slips, s.served, s.money, tostring(s.ended))
end
function __act(stationId, kind)
  local r = G.act(tostring(stationId), tostring(kind or 'press'))
  return (r and r.ok) and 'ok' or ('no: ' .. tostring(r and r.why))
end
function __bot()
  local K = __m_kitchen(); local S = __m_state()
  local s = G.s
  if not s or s.ended then return 'done' end
  if s.settling then G.nextDay(); return 'nextday' end
  for _, sl in ipairs(s.slips) do
    if sl.ready then K.deliverCup(s, sl); return 'pack' end
    local nx = S.nextStep(sl.cup)
    if nx then
      if sl.st ~= nx.st then K.routeSlip(s, sl, nx.st) end
      if nx.kind == 'hold' then nx.holdOn = true; K.tickHolds(s, 0.05) else K.pressStep(s, sl) end
      return 'work'
    end
  end
  for _, o in ipairs(s.orders) do for _, c in ipairs(o.cups) do
    if not c.made and K.slipFor(s, c) == nil and c.slotReady then G.startCup(c.rec.id); return 'start' end
  end end
  return 'idle'
end
function __counts()
  local imgOn, imgAll, txtOn, txtAll = 0, 0, 0, 0
  local function walk(c, depth)
    if not c or depth > 3 then return end
    local t = H.kindOf(c)
    local on = false
    pcall(function() on = (c.active ~= false) and (c.visible ~= false) end)
    if t:find('Image', 1, true) then imgAll = imgAll + 1; if on then imgOn = imgOn + 1 end end
    if t:find('TextBox', 1, true) then txtAll = txtAll + 1; if on then txtOn = txtOn + 1 end end
    local ok, kids = pcall(function() return c:GetChildren() end)
    if ok and type(kids) == 'table' then for i = 1, #kids do walk(kids[i], depth + 1) end end
  end
  if hostCfg and hostCfg.root then walk(hostCfg.root, 0) end
  return string.format('IMG %d/%d  TXT %d/%d', imgOn, imgAll, txtOn, txtAll)
end
-- 自检：把每个方块的 active/visible 报出来（排查"方块没显示"这类问题）
function __diag()
  local out = {}
  local function st(c, tag)
    if not c then out[#out + 1] = tag .. '=nil'; return end
    local a, vis = '?', '?'
    pcall(function() a = tostring(c.active) end)
    pcall(function() vis = tostring(c.visible) end)
    out[#out + 1] = string.format('%s(%s,%s)', tag, a, vis)
  end
  if v then
    for _, sid in ipairs({ 'shake', 'fire', 'chem', 'brew' }) do
      local slot = v.stations[sid]
      if slot then st(slot.box, 'box_' .. sid); st(slot.edge, 'edge_' .. sid) end
    end
    st(v.pack.box, 'pack')
    st(v.hud.title, 'hud')
  end
  local txt = 'DBG scene=' .. tostring(scene) .. ' dim=' .. tostring(v and v.dimmed) .. ' ' .. table.concat(out, ' ')
  if v and v.hud and v.hud.title then H.setText(v.hud.title, txt) end
  return txt
end
function __menu(m)
  if m then menuMode = math.max(1, math.min(3, tonumber(m) or 1)) end
  if scene == 'menu' and v then V.drawMenu(v, menuMode) end
  return 'mode=' .. tostring(IN.MODES[menuMode]) .. ' scene=' .. tostring(scene)
end

return { OnInit = OnInit, OnStart = OnStart, OnUpdate = OnUpdate,
         OnLevelUpdate = OnLevelUpdate, OnDestroy = OnDestroy,
         __state = __state, __act = __act, __bot = __bot, __counts = __counts, __menu = __menu, __diag = __diag }

end